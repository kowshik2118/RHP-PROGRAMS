#include <iostream>
#include <vector>
#include <cctype>

using namespace std;

bool checkPangram(const string &s) {
    vector<bool> mark(26, false);
    for (char c : s) {
        if (isalpha(c)) {
            mark[tolower(c) - 'a'] = true;
        }
    }
    for (bool present : mark) {
        if (!present) return false;
    }
    return true;
}

int main() {
    string str = "The quick brown fox jumps over the lazy dog";
    if (checkPangram(str))
        cout << "Yes, it is a pangram." << endl;
    else
        cout << "No, it is not a pangram." << endl;
    return 0;
}
